# Browser. With VITE_SUPABASE_URL unset, `pnpm dev` uses a local mock backend.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to 1 to run a built site on the mock, with a notice. Ignored when the URL above is set.
VITE_DEMO=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
VITE_SENTRY_DSN=
# Both default to Vercel's build variables. Set them only to override.
VITE_RELEASE=
VITE_SITE_URL=

# scripts/load-coupons.ts only. Never prefix the service key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Edge Function secrets, set with `supabase secrets set`.
# HOST_JWT_SECRET=
# ALLOWED_ORIGIN=https://your-domain.example
