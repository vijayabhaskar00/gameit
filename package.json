{
  "name": "gameit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "coupons": "node --experimental-strip-types --env-file-if-exists=.env scripts/load-coupons.ts",
    "difficulty": "node --experimental-strip-types --no-warnings scripts/difficulty.ts",
    "attack": "node --experimental-strip-types --no-warnings scripts/attack.ts",
    "load-users": "node --experimental-strip-types --no-warnings --env-file-if-exists=.env scripts/load-users.ts"
  },
  "dependencies": {
    "@sentry/react": "^11.10.0",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/og": "0.11.1",
    "marked": "^18.1.2",
    "phaser": "~3.90.0",
    "posthog-js": "^1.443.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pg": "8.23.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
